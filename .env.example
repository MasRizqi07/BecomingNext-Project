# Public Firebase web configuration. These values identify a Firebase app;
# secrets such as GEMINI_API_KEY must never be added to a VITE_* variable.
VITE_FIREBASE_API_KEY="replace-me"
VITE_FIREBASE_AUTH_DOMAIN="replace-me.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="replace-me"
VITE_FIREBASE_STORAGE_BUCKET="replace-me.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="replace-me"
VITE_FIREBASE_APP_ID="replace-me"
VITE_FIRESTORE_DATABASE_ID="(default)"

# Required in staging and production when App Check enforcement is enabled.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY="replace-me"

# Local development only.
VITE_USE_FIREBASE_EMULATORS="false"
VITE_APPCHECK_DEBUG="false"
