{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastSeen": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Reflection": {
      "title": "Reflection",
      "description": "A set of responses from a user reflection session",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "responses": {
          "type": "object",
          "description": "Key-value pairs of questions and answers"
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "responses", "createdAt"]
    },
    "Analysis": {
      "title": "Analysis",
      "description": "AI-generated insights based on reflections",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "reflectionId": { "type": "string" },
        "identity": { "type": "object" },
        "futureA": { "type": "object", "description": "The Drifting Version" },
        "futureB": { "type": "object", "description": "The Becoming Version" },
        "radarData": { "type": "array" },
        "futureLetter": { "type": "string" },
        "timeline": { "type": "array" },
        "plan": { "type": "object" },
        "identityCard": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "reflectionId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Store individual user profiles"
    },
    "/reflections/{reflectionId}": {
      "schema": "Reflection",
      "description": "Store user intake responses"
    },
    "/analyses/{analysisId}": {
      "schema": "Analysis",
      "description": "Store AI generated analysis results"
    }
  }
}
