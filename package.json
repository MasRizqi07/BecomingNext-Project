{
  "name": "becoming-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run build:web && npm run build:functions",
    "build:web": "vite build && node scripts/check-bundle.mjs",
    "build:functions": "npm --prefix functions run build",
    "preview": "vite preview --port=4173 --host=0.0.0.0",
    "clean": "rimraf dist coverage functions/lib playwright-report test-results",
    "typecheck": "npm run typecheck:web && npm run typecheck:functions",
    "typecheck:web": "tsc --noEmit",
    "typecheck:functions": "npm --prefix functions run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:functions": "npm --prefix functions test",
    "test:transactions": "firebase emulators:exec --only firestore --project demo-becoming \"npm --prefix functions run test:transactions:unit\"",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rules": "firebase emulators:exec --only firestore --project demo-becoming \"npm run test:rules:unit\"",
    "test:rules:unit": "vitest run --config vitest.rules.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:phase1": "playwright test --config playwright.phase1.config.ts",
    "test:e2e:visual": "playwright test tests/e2e/visual-regression.spec.ts --project=chromium-desktop --project=chromium-mobile",
    "test:e2e:auth": "node scripts/run-auth-e2e.mjs",
    "test:e2e:auth:run": "cross-env VITE_USE_FIREBASE_EMULATORS=true playwright test --config playwright.auth.config.ts",
    "test:evidence": "node scripts/check-e2e-evidence.mjs",
    "audit": "npm audit --omit=dev --audit-level=high && npm --prefix functions audit --omit=dev --audit-level=high",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run test:functions && npm run build && npm run audit",
    "verify:full": "npm run verify && npm run test:transactions && npm run test:rules && npm run test:e2e && npm run test:e2e:phase1 && npm run test:e2e:auth && npm run test:evidence"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.9.1",
    "firebase": "^12.13.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.0",
    "recharts": "^3.8.1",
    "zod": "^4.5.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "cross-env": "^10.0.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "firebase-tools": "^15.28.0",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.0",
    "rimraf": "^6.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.4",
    "body-parser@^1.0.0": "1.20.6",
    "express@^4.0.0": "4.22.2",
    "protobufjs": "^7.6.6",
    "qs@^6.0.0": "6.16.0",
    "websocket-driver": "^0.7.5"
  },
  "allowScripts": {
    "protobufjs@7.6.6": true,
    "@firebase/util@1.15.1": true,
    "@tsparticles/engine@3.9.1": true,
    "re2@1.26.1": true
  }
}
